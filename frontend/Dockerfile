# ==========================================
# STAGE 1: BUILDER (Build with Node)
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

# Build arguments required by Vite for build-time injection into the JS bundle
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_AURA_BACKEND_URL=http://localhost:4000
ARG VITE_AURA_FRONTEND_URL=http://localhost:3000

ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_AURA_BACKEND_URL=$VITE_AURA_BACKEND_URL
ENV VITE_AURA_FRONTEND_URL=$VITE_AURA_FRONTEND_URL

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build


# ==========================================
# STAGE 2: RUNNER (Ultra-lightweight Nginx server)
# ==========================================
FROM nginx:1.27-alpine

# Replace default Nginx configuration with custom config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy ONLY static assets generated by Vite from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose standard HTTP port
EXPOSE 80

# Start Nginx in the foreground
CMD ["nginx", "-g", "daemon off;"]
